defmodule AriaEngine.MCPSchemaValidationTest do
  @moduledoc """
  Unit tests for MCP schema validation logic.
  
  These are proper unit tests following Martin Fowler's definition:
  - Fast (< 1ms per test)
  - Isolated (no external dependencies)
  - Focused (single unit of functionality)
  """

  use ExUnit.Case, async: true
  alias AriaEngine.MCPToolsV2

  describe "get_input_schema/1" do
    test "returns valid JSON schema for schedule_activities" do
      schema = MCPToolsV2.get_input_schema(:schedule_activities)
      
      assert schema["type"] == "object"
      assert is_map(schema["properties"])
      assert is_list(schema["required"])
      assert "schedule_name" in schema["required"]
      assert "activities" in schema["required"]
    end

    test "schedule_activities schema has all required properties" do
      schema = MCPToolsV2.get_input_schema(:schedule_activities)
      properties = schema["properties"]
      
      # Core required properties
      assert Map.has_key?(properties, "schedule_name")
      assert Map.has_key?(properties, "activities")
      
      # Enhanced properties
      assert Map.has_key?(properties, "entities")
      assert Map.has_key?(properties, "resources")
      assert Map.has_key?(properties, "constraints")
      assert Map.has_key?(properties, "simulation_options")
      assert Map.has_key?(properties, "resource_management")
      assert Map.has_key?(properties, "pipeline_topology")
    end

    test "activities schema supports enhanced duration formats" do
      schema = MCPToolsV2.get_input_schema(:schedule_activities)
      activities_schema = schema["properties"]["activities"]["items"]["properties"]["duration"]
      
      assert activities_schema["oneOf"]
      assert length(activities_schema["oneOf"]) == 2
      
      # First option: ISO 8601 string
      string_option = Enum.at(activities_schema["oneOf"], 0)
      assert string_option["type"] == "string"
      assert String.contains?(string_option["description"], "ISO 8601")
      
      # Second option: Time interval object
      object_option = Enum.at(activities_schema["oneOf"], 1)
      assert object_option["type"] == "object"
      assert Map.has_key?(object_option["properties"], "start")
      assert Map.has_key?(object_option["properties"], "end")
      assert String.contains?(object_option["description"], "open-ended")
    end

    test "entities schema supports enhanced fields" do
      schema = MCPToolsV2.get_input_schema(:schedule_activities)
      entities_schema = schema["properties"]["entities"]["items"]["properties"]
      
      assert Map.has_key?(entities_schema, "id")
      assert Map.has_key?(entities_schema, "type")
      assert Map.has_key?(entities_schema, "capabilities")
      assert Map.has_key?(entities_schema, "availability")
      assert Map.has_key?(entities_schema, "current_activity")
      assert Map.has_key?(entities_schema, "resources_held")
      assert Map.has_key?(entities_schema, "metadata")
      
      # Availability supports multiple formats
      availability_schema = entities_schema["availability"]
      assert availability_schema["oneOf"]
      assert length(availability_schema["oneOf"]) == 2
    end

    test "resources schema supports capacity management" do
      schema = MCPToolsV2.get_input_schema(:schedule_activities)
      resources_schema = schema["properties"]["resources"]["additionalProperties"]["properties"]
      
      assert Map.has_key?(resources_schema, "type")
      assert Map.has_key?(resources_schema, "capacity")
      assert Map.has_key?(resources_schema, "current_usage")
      assert Map.has_key?(resources_schema, "constraints")
      assert Map.has_key?(resources_schema, "availability_schedule")
      assert Map.has_key?(resources_schema, "metadata")
      
      assert resources_schema["capacity"]["type"] == "number"
      assert resources_schema["current_usage"]["type"] == "number"
    end

    test "simulation_options schema has correct structure" do
      schema = MCPToolsV2.get_input_schema(:schedule_activities)
      sim_options = schema["properties"]["simulation_options"]["properties"]
      
      assert Map.has_key?(sim_options, "simulation_mode")
      assert Map.has_key?(sim_options, "verbose")
      assert Map.has_key?(sim_options, "log_activities")
      
      assert sim_options["simulation_mode"]["type"] == "boolean"
      assert sim_options["verbose"]["type"] == "number"
      assert sim_options["log_activities"]["type"] == "boolean"
    end

    test "resource_management schema has correct structure" do
      schema = MCPToolsV2.get_input_schema(:schedule_activities)
      resource_mgmt = schema["properties"]["resource_management"]["properties"]
      
      assert Map.has_key?(resource_mgmt, "check_capacity")
      assert Map.has_key?(resource_mgmt, "auto_allocate")
      assert Map.has_key?(resource_mgmt, "conflict_detection")
      
      assert resource_mgmt["check_capacity"]["type"] == "boolean"
      assert resource_mgmt["auto_allocate"]["type"] == "boolean"
      assert resource_mgmt["conflict_detection"]["type"] == "boolean"
    end
  end

  describe "schema validation logic" do
    test "validates minimal valid schedule_activities request" do
      minimal_params = %{
        "schedule_name" => "test_schedule",
        "activities" => [
          %{
            "id" => "activity_1",
            "duration" => "PT1H"
          }
        ]
      }
      
      # This should not raise an error when processed
      result = MCPToolsV2.handle_tool_call(:schedule_activities, minimal_params)
      
      # Should return a result (not an error about missing required fields)
      assert Map.has_key?(result, "status")
      refute result["status"] == "error" and String.contains?(result["error"] || "", "required")
    end

    test "validates enhanced duration formats" do
      # Test ISO 8601 duration
      iso_params = %{
        "schedule_name" => "iso_test",
        "activities" => [
          %{
            "id" => "iso_activity",
            "duration" => "PT2H30M"
          }
        ]
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, iso_params)
      assert Map.has_key?(result, "status")
      
      # Test interval duration
      interval_params = %{
        "schedule_name" => "interval_test",
        "activities" => [
          %{
            "id" => "interval_activity",
            "duration" => %{
              "start" => "2025-06-20T09:00:00Z",
              "end" => "2025-06-20T17:00:00Z"
            }
          }
        ]
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, interval_params)
      assert Map.has_key?(result, "status")
    end

    test "validates open-ended intervals" do
      # Test start-only interval
      start_only_params = %{
        "schedule_name" => "start_only_test",
        "activities" => [
          %{
            "id" => "start_only_activity",
            "duration" => %{
              "start" => "2025-06-20T09:00:00Z"
            }
          }
        ]
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, start_only_params)
      assert Map.has_key?(result, "status")
      
      # Test end-only interval
      end_only_params = %{
        "schedule_name" => "end_only_test",
        "activities" => [
          %{
            "id" => "end_only_activity",
            "duration" => %{
              "end" => "2025-06-20T17:00:00Z"
            }
          }
        ]
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, end_only_params)
      assert Map.has_key?(result, "status")
    end

    test "validates enhanced entity fields" do
      enhanced_params = %{
        "schedule_name" => "entity_test",
        "activities" => [
          %{
            "id" => "entity_activity",
            "duration" => "PT1H",
            "participants" => ["entity_1"],
            "required_capabilities" => ["cooking"],
            "required_resources" => ["kitchen"]
          }
        ],
        "entities" => [
          %{
            "id" => "entity_1",
            "type" => "chef",
            "capabilities" => ["cooking", "baking"],
            "availability" => "PT8H",
            "current_activity" => nil,
            "resources_held" => [],
            "metadata" => %{
              "skill_level" => "expert"
            }
          }
        ]
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, enhanced_params)
      assert Map.has_key?(result, "status")
    end

    test "validates resource management fields" do
      resource_params = %{
        "schedule_name" => "resource_test",
        "activities" => [
          %{
            "id" => "resource_activity",
            "duration" => "PT1H",
            "required_resources" => ["kitchen"]
          }
        ],
        "resources" => %{
          "kitchen" => %{
            "type" => "facility",
            "capacity" => 2,
            "current_usage" => 0,
            "constraints" => %{
              "max_concurrent_users" => 2
            },
            "availability_schedule" => [
              %{
                "start" => "2025-06-20T08:00:00Z",
                "end" => "2025-06-20T18:00:00Z"
              }
            ],
            "metadata" => %{
              "location" => "building_a"
            }
          }
        },
        "resource_management" => %{
          "check_capacity" => true,
          "auto_allocate" => true,
          "conflict_detection" => true
        }
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, resource_params)
      assert Map.has_key?(result, "status")
    end

    test "validates simulation options" do
      simulation_params = %{
        "schedule_name" => "simulation_test",
        "activities" => [
          %{
            "id" => "sim_activity",
            "duration" => "PT1H"
          }
        ],
        "simulation_options" => %{
          "simulation_mode" => true,
          "verbose" => 2,
          "log_activities" => true
        }
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, simulation_params)
      assert Map.has_key?(result, "status")
    end

    test "validates constraints" do
      constraint_params = %{
        "schedule_name" => "constraint_test",
        "activities" => [
          %{
            "id" => "constraint_activity",
            "duration" => "PT1H"
          }
        ],
        "constraints" => %{
          "max_concurrent_activities" => 5,
          "require_resources" => true
        }
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, constraint_params)
      assert Map.has_key?(result, "status")
    end
  end

  describe "error handling" do
    test "handles missing required fields gracefully" do
      # Missing schedule_name
      invalid_params = %{
        "activities" => [
          %{
            "id" => "test_activity",
            "duration" => "PT1H"
          }
        ]
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, invalid_params)
      
      # Should handle gracefully (may create pipeline with default name or return error)
      assert Map.has_key?(result, "status")
    end

    test "handles invalid tool names gracefully" do
      result = MCPToolsV2.handle_tool_call(:invalid_tool, %{})
      
      assert result["error"] == "Unknown tool: invalid_tool"
    end

    test "handles exceptions in tool execution" do
      # This will likely cause an exception due to invalid pipeline topology
      result = MCPToolsV2.handle_tool_call(:schedule_activities, %{
        "schedule_name" => "exception_test",
        "activities" => [],
        "pipeline_topology" => "invalid_topology"
      })
      
      # Should catch exception and return error response
      assert Map.has_key?(result, "status")
    end
  end

  describe "schema completeness" do
    test "all tools have input schemas defined" do
      tools = MCPToolsV2.get_tools()
      
      Enum.each(tools, fn tool ->
        tool_name = String.to_atom(tool["name"])
        schema = MCPToolsV2.get_input_schema(tool_name)
        
        assert is_map(schema)
        assert Map.has_key?(schema, "type")
        assert Map.has_key?(schema, "properties")
      end)
    end

    test "schedule_activities schema is most comprehensive" do
      schedule_schema = MCPToolsV2.get_input_schema(:schedule_activities)
      other_schemas = [
        :configure_pipeline_layout,
        :setup_element_config,
        :start_planning_pipeline
      ] |> Enum.map(&MCPToolsV2.get_input_schema/1)
      
      schedule_property_count = map_size(schedule_schema["properties"])
      
      Enum.each(other_schemas, fn schema ->
        other_property_count = map_size(schema["properties"])
        assert schedule_property_count >= other_property_count
      end)
    end

    test "enhanced fields are properly documented" do
      schema = MCPToolsV2.get_input_schema(:schedule_activities)
      
      # Check that enhanced fields have descriptions
      enhanced_fields = [
        "entities",
        "resources", 
        "constraints",
        "simulation_options",
        "resource_management"
      ]
      
      Enum.each(enhanced_fields, fn field ->
        field_schema = schema["properties"][field]
        assert Map.has_key?(field_schema, "description")
        assert is_binary(field_schema["description"])
        assert String.length(field_schema["description"]) > 10
      end)
    end
  end

  describe "backward compatibility" do
    test "original simple format still works" do
      # Original format from before enhancement
      original_params = %{
        "schedule_name" => "backward_compat_test",
        "activities" => [
          %{
            "id" => "simple_activity",
            "duration" => "PT1H",
            "dependencies" => []
          }
        ]
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, original_params)
      assert Map.has_key?(result, "status")
    end

    test "can mix old and new format fields" do
      mixed_params = %{
        "schedule_name" => "mixed_test",
        "activities" => [
          %{
            "id" => "mixed_activity",
            "duration" => "PT1H",  # Old format
            "required_capabilities" => ["new_field"]  # New format
          }
        ],
        "simulation_options" => %{  # New section
          "simulation_mode" => true
        }
      }
      
      result = MCPToolsV2.handle_tool_call(:schedule_activities, mixed_params)
      assert Map.has_key?(result, "status")
    end
  end
end
