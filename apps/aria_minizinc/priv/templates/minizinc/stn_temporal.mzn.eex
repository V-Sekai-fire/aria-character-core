% Generated MiniZinc Model - Simple Temporal Network Problem
% Variables: <%= @num_time_points %>
% Generated at: <%= @generation_start %>

int: num_time_points = <%= @num_time_points %>;

<%= if @num_time_points > 0 do %>
int: horizon = <%= @horizon %>;
set of int: TIME_POINTS = 1..num_time_points;

% Time point names for debugging
array[TIME_POINTS] of string: time_point_names = [<%= Enum.map_join(@time_point_names, ", ", &"\"#{&1}\"") %>];

% Distance constraint matrix
% distance_matrix[i,j] = maximum distance from time point i to time point j
% Constraint: time_points[j] - time_points[i] <= distance_matrix[i,j]
array[TIME_POINTS, TIME_POINTS] of int: distance_matrix = [|<%= for {row, row_index} <- Enum.with_index(@distance_matrix) do %>
  <%= Enum.join(row, ", ") %><%= if row_index < length(@distance_matrix) - 1, do: " |", else: "" %><% end %>
|];

% Decision variables - time point assignments
array[TIME_POINTS] of var 0..horizon: time_points;

% STN Constraints
% Core STN constraint: time_points[j] - time_points[i] <= distance_matrix[i,j]
constraint forall(i, j in TIME_POINTS) (
  time_points[j] - time_points[i] <= distance_matrix[i,j]
);

% Objective: minimize makespan (latest time point)
var 0..horizon: makespan;
constraint makespan = max(time_points);

solve minimize makespan;

% Output format
output [
  "time_points = [" ++ join(", ", [show(time_points[i]) | i in TIME_POINTS]) ++ "];\n",
  "makespan = " ++ show(makespan) ++ ";\n",
  "% Time point assignments:\n"
] ++ [
  "% " ++ time_point_names[i] ++ " = " ++ show(time_points[i]) ++ "\n" | i in TIME_POINTS
];
<% else %>
% Empty STN problem - no time points to schedule
var 0..0: makespan = 0;

solve satisfy;

% Output format for empty problem
output [
  "time_points = [];\n",
  "makespan = 0;\n",
  "% Empty STN problem - no time points\n"
];
<% end %>
